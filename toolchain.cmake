set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER /usr/bin/aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER /usr/bin/aarch64-linux-gnu-g++)
set(CMAKE_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/f45-cross")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(_f45_cxx "${CMAKE_SYSROOT}/usr/include/c++/16")
set(CMAKE_C_FLAGS_INIT "-DMB_LEN_MAX=16")
set(CMAKE_CXX_FLAGS_INIT "-DMB_LEN_MAX=16 -isystem ${_f45_cxx} -isystem ${_f45_cxx}/aarch64-redhat-linux -isystem ${_f45_cxx}/backward")
set(_f45_link "-L${CMAKE_SYSROOT}/usr/lib/gcc/aarch64-redhat-linux/16 -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_f45_link}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_f45_link}")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib64/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
